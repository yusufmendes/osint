strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=false
node-linker=isolated
link-workspace-packages=false
prefer-workspace-packages=false

# Shared content-addressed store under the toolchain repo, so deleting that
# folder fully resets every install across the workspace.
store-dir=../../isr-tools/.tools/pnpm-store

# Project-pinned registry: ignore any host-level Verdaccio / corp proxy.
registry=https://registry.npmjs.org/
