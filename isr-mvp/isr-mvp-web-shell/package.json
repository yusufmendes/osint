{
  "name": "isr-mvp-web-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Shell application - layout, auth, routing, single global RTK store, single QueryClient. Top-level repo of the multi-repo ISR MVP frontend.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "bootstrap:siblings": "node ./scripts/install-siblings.mjs",
    "build-mvp-web-shell": "pnpm bootstrap:siblings && pnpm install && pnpm typecheck && pnpm test && pnpm build",
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.0",
    "@tanstack/react-query": "^5.50.0",
    "@tanstack/react-query-devtools": "^5.50.0",
    "@tanstack/react-router": "^1.50.0",
    "@mui/material": "^7.0.0",
    "@mui/icons-material": "^7.0.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.0",
    "isr-web-core": "link:../../isr-core-modules/isr-web-core",
    "isr-gis-web": "link:../../isr-gis-modules/isr-gis-web",
    "isr-video-web": "link:../../isr-video-modules/isr-video-web",
    "isr-intelligence-web": "link:../../isr-intelligence-modules/isr-intelligence-web",
    "isr-search-web": "link:../../isr-search-modules/isr-search-web"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
